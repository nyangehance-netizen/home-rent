# Copy this file to .env and fill in the values from
# Supabase dashboard → Project Settings → API (or "API Keys").
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# The public "anon" key or the newer "publishable" key. Never put the service_role / secret key here.
EXPO_PUBLIC_SUPABASE_KEY=YOUR-ANON-OR-PUBLISHABLE-KEY
